
<%= form_with Course: @course do |first|%>

<div>
<%=first.label :course_name%><br>
<%=first.text_field :course_name%>
</div>
<br>
<div>
<%=first.label :description%><br>
<%=first.text_field :description%>
</div>
<br>
<div>
<%=first.label :duration_week%><br>
<%=first.number_field :duration_week%>
</div>
<br>
<div>
<%=first.label :status%><br>
<%=first.text_field:status%>
</div>
<br>

<div>
<%= first.submit "create"%>
</div>
<%end%>

